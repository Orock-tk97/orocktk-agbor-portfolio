---
import { projects } from "../data/site";
---
<section id="projects" aria-labelledby="projects-title" class="py-24 border-b border-lightMuted dark:border-darkSubtle/60 bg-lightCanvas dark:bg-darkCanvas transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-14">
      <span class="font-mono text-xs font-medium text-indigo-600 dark:text-indigo-400 tracking-widest block mb-2">~/projects</span>
      <h2 id="projects-title" class="font-serif text-4xl sm:text-5xl font-normal text-slate-900 dark:text-white">Featured Projects</h2>
    </div>

    <!-- Thumbnails: put images in /public/images (names set in src/data/site.ts) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p) => {
        const soon = p.href === undefined;
        return (
          <article
            data-coming-soon={soon ? p.title : undefined}
            data-progress={soon ? p.progress : undefined}
            class:list={["bg-lightSurface dark:bg-darkSurface border border-lightMuted dark:border-darkSubtle rounded-2xl overflow-hidden hover:shadow-glow hover:-translate-y-1 transition-all duration-300 group flex flex-col", soon && "cursor-pointer"]}
          >
            <div class="relative h-32 overflow-hidden bg-gradient-to-br from-indigo-500/10 via-accent-500/5 to-transparent border-b border-lightMuted dark:border-darkSubtle flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-3xl text-indigo-500`} aria-hidden="true"></i>
              <img src={`/images/${p.img}`} alt={`${p.title} thumbnail`} width="400" height="128" loading="lazy" decoding="async" onerror="this.remove()" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <span class:list={["absolute top-2 right-2 z-10 text-[10px] font-mono font-bold text-white px-2.5 py-1 rounded-full", soon ? "bg-slate-900/85 backdrop-blur-sm" : "bg-emerald-500"]}>
                {soon ? `${p.progress}% · Coming soon` : "Live demo"}
              </span>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <span class="text-[10px] font-mono text-indigo-500 uppercase tracking-wider block mb-1">{p.tag}</span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">{p.title}</h3>
              <p class="text-slate-600 dark:text-slate-300 text-xs mb-3 leading-relaxed">{p.text}</p>
              {soon ? (
                <button type="button" class="nudge mt-auto inline-flex items-center text-xs font-semibold text-slate-900 dark:text-white group-hover:text-indigo-500 transition">
                  See progress <i class="fa-solid fa-arrow-right ml-1.5 text-[10px] text-indigo-500" aria-hidden="true"></i>
                </button>
              ) : (
                <a href={p.href} target="_blank" rel="noopener" class="nudge mt-auto inline-flex items-center text-xs font-semibold text-slate-900 dark:text-white group-hover:text-indigo-500 transition">
                  Try the live demo <i class="fa-solid fa-arrow-up-right-from-square ml-1.5 text-[10px] text-indigo-500" aria-hidden="true"></i>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
