---
import { site, services } from "../data/site";
const field = "w-full bg-lightCanvas dark:bg-darkCanvas border border-lightMuted dark:border-darkSubtle focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white outline-none transition shadow-subtle";
const label = "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2";
const budgets = ["Under $2,500", "$2,500 – $5,000", "$5,000 – $15,000", "$15,000+"];
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---
<section id="contact" aria-labelledby="contact-title" class="py-24 border-b border-lightMuted dark:border-darkSubtle/60 bg-gradient-to-b from-lightSubtle to-lightCanvas dark:from-darkSurface dark:to-darkCanvas transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4 space-y-6">
        <div>
          <span class="font-mono text-xs font-medium text-indigo-600 dark:text-indigo-400 tracking-widest block mb-2">~/contact</span>
          <h2 id="contact-title" class="font-serif text-4xl sm:text-5xl font-normal text-slate-900 dark:text-white leading-tight">Let's Build Something</h2>
        </div>
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">Have a machine learning problem, a data project or a web application in mind? Reach out and let's talk about how we can work together.</p>
        <address class="not-italic space-y-3 pt-2 text-xs font-medium text-slate-700 dark:text-slate-200">
          <p class="flex items-center gap-3"><i class="fa-solid fa-envelope text-indigo-500 w-4" aria-hidden="true"></i><a href={`mailto:${site.email}`} class="hover:text-indigo-500 transition">{site.email}</a></p>
          <p class="flex items-center gap-3"><i class="fa-solid fa-location-dot text-indigo-500 w-4" aria-hidden="true"></i>{site.location}</p>
          <p class="flex items-center gap-3"><i class="fa-brands fa-linkedin-in text-indigo-500 w-4" aria-hidden="true"></i><a href={site.linkedin} target="_blank" rel="noopener me" class="hover:text-indigo-500 transition">linkedin.com/in/orocktakang-agbor</a></p>
        </address>
      </div>

      <div class="lg:col-span-8">
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="bg-lightSurface/90 dark:bg-darkSurface/90 border border-lightMuted dark:border-darkSubtle rounded-2xl p-6 sm:p-8 space-y-5 shadow-subtle backdrop-blur-md">
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="from_name" value="Portfolio contact" />
          <input type="hidden" name="subject" value="New portfolio inquiry" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="grid sm:grid-cols-2 gap-5">
            <div><label for="name" class={label}>Your Name</label><input id="name" name="name" type="text" autocomplete="name" required placeholder="Jane Doe" class={field} /></div>
            <div><label for="email" class={label}>Email Address</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="jane@company.com" class={field} /></div>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="service" class={label}>Service Required</label>
              <select id="service" name="service" required class={field}>
                <option value="">Select a service</option>
                {services.map((s) => <option>{s.title}</option>)}
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="budget" class={label}>Budget Range <span class="text-slate-400 normal-case font-normal">(optional)</span></label>
              <select id="budget" name="budget" class={field}>
                <option value="">Not specified</option>
                {budgets.map((b) => <option>{b}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label for="details" class={label}>Project Overview</label>
            <textarea id="details" name="details" rows="4" required placeholder="Tell me about your goals, timeline, or key technical requirements." class={`${field} resize-none`}></textarea>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
            <p id="form-status" class="text-xs text-slate-500 dark:text-slate-400" role="status" aria-live="polite">Your message is sent to my email. I usually reply within a few days.</p>
            <button id="contact-submit" type="submit" class="cta-pulse inline-flex items-center justify-center bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold px-7 py-3 rounded-full transition shadow-solidBtn text-xs tracking-tight shrink-0 disabled:opacity-60 disabled:cursor-not-allowed">
              Send Inquiry <i class="fa-solid fa-paper-plane ml-2 text-[10px]" aria-hidden="true"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
