---
import { site, skills, timeline, education, stats } from "../data/site";
const pill = "bg-lightSurface dark:bg-darkSubtle border border-lightMuted dark:border-darkSubtle px-3.5 py-1.5 rounded-full text-xs font-medium text-slate-800 dark:text-slate-200 shadow-subtle inline-flex items-center gap-2";
---
<section id="about" aria-labelledby="about-title" class="py-24 border-b border-lightMuted dark:border-darkSubtle/60 bg-gradient-to-b from-lightSubtle to-lightCanvas dark:from-darkSurface dark:to-darkCanvas transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5">
        <div class="bg-lightSurface dark:bg-darkSurface border border-lightMuted dark:border-darkSubtle rounded-2xl p-4 shadow-subtle space-y-4">
          <figure class="relative aspect-[4/5] rounded-xl overflow-hidden bg-lightSubtle dark:bg-darkSubtle border border-lightMuted dark:border-darkSubtle group">
            <img src="/images/me.jpg" alt={`${site.name}, software and machine learning engineer`} width="800" height="1000" loading="lazy" decoding="async" class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-[1.02]" />
            <figcaption class="absolute bottom-3 left-3 right-3 bg-lightSurface/95 dark:bg-darkSurface/95 backdrop-blur border border-lightMuted dark:border-darkSubtle p-3 rounded-lg text-xs shadow-subtle">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-900 dark:text-white">{site.name}</span>
                <span class="text-[10px] font-mono text-indigo-500 font-semibold">{site.location}</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 mt-0.5">{site.shortRole}</p>
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-8">
        <div>
          <span class="font-mono text-xs font-medium text-indigo-600 dark:text-indigo-400 tracking-widest block mb-2">~/about</span>
          <h2 id="about-title" class="font-serif text-4xl sm:text-5xl font-normal text-slate-900 dark:text-white leading-tight">Engineering with Precision</h2>
        </div>

        <div class="space-y-4 text-slate-700 dark:text-slate-200 text-sm sm:text-base leading-relaxed">
          <p>I'm a software engineer and a machine learning / AI engineer. I build the whole path from data and models to the APIs and web apps that put them to work, with a focus on solutions that are practical, scalable and easy to explain.</p>
          <p>I work across Python, deep learning and modern web stacks like React, Node.js and FastAPI. I'm especially interested in applying ML to fintech problems such as credit scoring, fraud detection and risk modelling in emerging African markets.</p>
        </div>

        <div id="skills">
          <h3 class="text-xs font-mono font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4">Tools I work with</h3>
          <ul class="flex flex-wrap gap-2.5">
            {skills.map((s) => (
              <li class={pill}>
                {s.icon
                  ? <img src={`https://cdn.simpleicons.org/${s.icon}`} alt="" width="16" height="16" loading="lazy" class:list={["w-4 h-4", s.invert && "dark:invert"]} />
                  : <i class={`fa-solid ${s.fa} text-indigo-500 text-sm w-4 text-center`} aria-hidden="true"></i>}
                {s.n}
              </li>
            ))}
          </ul>
        </div>

        <ol class="pt-2 space-y-5 border-l border-slate-900/20 dark:border-white/20 pl-6">
          {timeline.map((t, i) => (
            <li class="relative">
              <span class:list={["absolute -left-[29px] top-1.5 w-3 h-3 rounded-full ring-4 ring-lightCanvas dark:ring-darkCanvas", i === 0 ? "bg-slate-900 dark:bg-white" : "bg-slate-400 dark:bg-slate-600"]}></span>
              <span class:list={["font-mono text-xs", i === 0 ? "text-indigo-500 font-medium" : "text-slate-500 dark:text-slate-400"]}>{t.years}</span>
              <h3 class="text-slate-900 dark:text-white font-semibold text-sm mt-0.5">{t.role} <span class="font-normal text-slate-500 dark:text-slate-400">&middot; {t.org}</span></h3>
              <p class="text-slate-600 dark:text-slate-300 text-xs mt-0.5">{t.text}</p>
            </li>
          ))}
        </ol>

        <div class="text-xs space-y-2">
          <h3 class="font-mono font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">Education</h3>
          {education.map((e) => (
            <div class="flex justify-between gap-4">
              <p class="text-sm font-semibold text-slate-900 dark:text-white">{e.name}</p>
              <span class="font-mono text-slate-500 dark:text-slate-400 shrink-0">{e.years}</span>
            </div>
          ))}
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2">
          {stats.map((s) => (
            <div class="bg-lightSurface dark:bg-darkSurface border border-lightMuted dark:border-darkSubtle rounded-xl p-4 text-center shadow-subtle">
              <dd class="font-serif text-3xl font-bold text-slate-900 dark:text-white order-2">{s.v}</dd>
              <dt class="text-[10px] font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-1">{s.l}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
