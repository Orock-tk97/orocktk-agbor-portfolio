---
import { services } from "../data/site";
---
<section id="services" aria-labelledby="services-title" class="py-24 border-b border-lightMuted dark:border-darkSubtle/60 bg-lightCanvas dark:bg-darkCanvas transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-14 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="font-mono text-xs font-medium text-indigo-600 dark:text-indigo-400 tracking-widest block mb-2">~/services</span>
        <h2 id="services-title" class="font-serif text-4xl sm:text-5xl font-normal text-slate-900 dark:text-white">How I Can Help</h2>
      </div>
      <p class="text-slate-600 dark:text-slate-300 text-sm max-w-md">Machine learning and software work with an emphasis on models and systems that are practical, interpretable and easy to audit.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((s) => (
        <article class="bg-lightSurface/80 dark:bg-darkSurface border border-lightMuted dark:border-darkSubtle p-8 rounded-2xl hover:border-indigo-500/50 transition-all shadow-subtle hover:shadow-glow group backdrop-blur-md">
          <div class="w-12 h-12 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center text-lg mb-6 shadow-solidBtn font-bold">
            <i class={`fa-solid ${s.icon}`} aria-hidden="true"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">{s.title}</h3>
          <p class="text-slate-600 dark:text-slate-300 text-xs leading-relaxed mb-6">{s.text}</p>
          <a href="#contact" aria-label={`Get in touch about ${s.title}`} class="nudge inline-flex items-center text-xs font-semibold text-accent-600 dark:text-accent-400 hover:underline">
            Get in touch <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]" aria-hidden="true"></i>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
